# =============================================================================
# The Shark Web — Headless Backend (Laravel 12 + Filament v3)
# =============================================================================
# Production template. Copy to `.env` and fill in the real values.
#
# PRODUCTION TARGET: Namecheap cPanel, subdomain api.thesharkweb.com
# LOCAL DEVELOPMENT:  use SQLite (see the LOCAL block at the bottom)
#
# SECURITY: never commit a populated .env. On cPanel the file must live OUTSIDE
# public_html (see docs/BACKEND_MVP_PLAN.md §8.1 for the document-root layout).
# =============================================================================

APP_NAME="The Shark Web"
APP_ENV=production
APP_KEY=
APP_DEBUG=false

# Canonical backend origin. Filament media URLs and the API base derive from this.
APP_URL=https://api.thesharkweb.com

APP_TIMEZONE=UTC
APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=daily
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=warning

# -----------------------------------------------------------------------------
# DATABASE — MySQL 8 (cPanel)
# -----------------------------------------------------------------------------
DB_CONNECTION=mysql
DB_HOST=localhost
DB_PORT=3306
DB_DATABASE=thesharkweb_backend
DB_USERNAME=
DB_PASSWORD=

# -----------------------------------------------------------------------------
# SESSION / CACHE / QUEUE
# -----------------------------------------------------------------------------
# Shared hosting has no persistent queue workers, so every notification is sent
# through a synchronous HTTP API (Resend / Telegram). The queue stays on
# `database` only as a safety net; nothing critical depends on a worker running.
# See docs/BACKEND_MVP_PLAN.md §4.
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=public
QUEUE_CONNECTION=database
CACHE_STORE=database

# -----------------------------------------------------------------------------
# EMAIL — Resend HTTP API (no queue worker required)
# -----------------------------------------------------------------------------
MAIL_MAILER=resend
RESEND_API_KEY=
MAIL_FROM_ADDRESS=noreply@thesharkweb.com
MAIL_FROM_NAME="${APP_NAME}"

# Admin recipients: new-lead alerts go to LEAD_NOTIFICATION_EMAIL.
LEAD_NOTIFICATION_EMAIL=info@thesharkweb.com

# Weekly performance digest (§14.13). Comma-separated. When empty the digest falls back
# to LEAD_NOTIFICATION_EMAIL, so a fresh install works without setting this.
DIGEST_RECIPIENTS=info@thesharkweb.com

# Daily KPI report. The on/off switch and the recipient live in Settings
# (Settings > Daily report) — these two only shape the schedule.
# The day is a Dhaka day, so the report covers the working day you just finished.
DAILY_REPORT_TIMEZONE=Asia/Dhaka
DAILY_REPORT_TIME=23:30

# -----------------------------------------------------------------------------
# AGENCY ASSETS & CONTACT (§14.11)
# -----------------------------------------------------------------------------
# The contact details documented in docs/existingwebsitecontents.md. They are used by the lead
# auto-responder and must match the public site's footer.
CONTACT_EMAIL=info@thesharkweb.com
CONTACT_WHATSAPP=+8801896444400

# Optional agency deck. Linked from the lead auto-responder's second call to action.
# LEAVE THIS BLANK until a real file exists — when it is empty the email omits the whole
# section, because a dead link in a client-facing email is worse than no link at all.
AGENCY_DECK_URL=

# -----------------------------------------------------------------------------
# SERVER-TO-SERVER AUTHENTICATION
# -----------------------------------------------------------------------------
# The visitor's browser NEVER calls this API. Next.js Server Actions proxy every
# request and authenticate with this high-entropy key (§7.1).
LARAVEL_API_KEY=

# Shared secret for the Next.js draft-preview flow (§5).
PREVIEW_SECRET=

# -----------------------------------------------------------------------------
# NEXT.JS / VERCEL INTEGRATION
# -----------------------------------------------------------------------------
# On-demand ISR revalidation target.
NEXTJS_URL=https://thesharkweb.com
REVALIDATE_SECRET=

# MUST BE TRUE once the frontend serves app/api/revalidate/route.ts — it does.
#
# This was FALSE while the route did not exist, which was correct then and wrong now. The
# symptom of leaving it off is subtle: a save in the panel still persists, but the public
# page keeps showing the old copy until the 5-minute ISR window lapses, so an edit looks
# like it did not save. With it on, ContentObserver purges the affected paths and tags
# immediately and the change is live on the next request.
#
# Both sides must carry the SAME REVALIDATE_SECRET. A mismatch is a 401, which the service
# records in webhook_logs as a failed dispatch rather than throwing into the save.
ISR_ENABLED=true

# Public site origin, used for canonical URLs, IndexNow host and the sitemap.
FRONTEND_URL=https://thesharkweb.com

# Comma-separated CORS allow-list. Preview deploys are matched by wildcard (§7.2).
CORS_ALLOWED_ORIGINS=https://thesharkweb.com,https://www.thesharkweb.com

# -----------------------------------------------------------------------------
# INSTANT INDEXING
# -----------------------------------------------------------------------------
# IndexNow key. The matching verification file must be served at
# https://thesharkweb.com/{INDEXNOW_KEY}.txt (§14.15).
INDEXNOW_KEY=
INDEXNOW_ENABLED=true

# Google Search Console Indexing API — path to the service-account JSON (§14.12).
GOOGLE_SERVICE_ACCOUNT_JSON=storage/keys/google-service-account.json
GOOGLE_INDEXING_ENABLED=false

# -----------------------------------------------------------------------------
# INSTANT LEAD ALERTS
# -----------------------------------------------------------------------------
# Telegram Bot API — free, zero-latency mobile alerts (§14.8).
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
TELEGRAM_ALERTS_ENABLED=true

# One-tap payment approvals from the chat. Register the webhook with:
#   php artisan sharkweb:telegram-webhook --set
# TELEGRAM_WEBHOOK_SECRET is echoed back by Telegram in a header; without it the
# endpoint refuses every request. TELEGRAM_OPERATOR_EMAIL is the account recorded
# as verified_by when a decision is made from Telegram (must be a real user).
TELEGRAM_WEBHOOK_SECRET=
TELEGRAM_OPERATOR_EMAIL=admin@thesharkweb.com

# Google Sheets / Notion / Make.com / Zapier webhook fan-out (§14.9).
LEAD_WEBHOOK_URL=
LEAD_WEBHOOK_SECRET=

# -----------------------------------------------------------------------------
# NEWSLETTER — Brevo
# -----------------------------------------------------------------------------
BREVO_API_KEY=
BREVO_LIST_ID=

# -----------------------------------------------------------------------------
# META CONVERSIONS API (server-side)
# -----------------------------------------------------------------------------
# These are the FALLBACKS for a fresh install only. Everything here is editable at
# runtime from the Filament settings page (Site settings → Analytics), and the panel
# wins once a value is set there — otherwise the field would be a lie.
#
# META_CAPI_ENABLED is read ONCE, by the settings migration, to seed the toggle. It is
# not consulted at runtime, because a switch that .env can outvote is not a switch.
FACEBOOK_PIXEL_ID=
META_CAPI_ACCESS_TOKEN=
META_TEST_EVENT_CODE=
META_CAPI_ENABLED=false

# -----------------------------------------------------------------------------
# BACKUPS (§14.14)
# -----------------------------------------------------------------------------
# MUST BE A REMOTE DISK IN PRODUCTION: s3, b2, or a Google Drive disk. A backup stored on
# the same shared cPanel account as the site is not a backup — quota exhaustion, account
# suspension or a lost server take the backup with them. `local` is for development only.
# Configure the disk itself in config/filesystems.php, then name it here.
# See docs/BACKEND_DEPLOYMENT_GUIDE.md §7.
BACKUP_DISK=local

# Where backup failure notifications are mailed. Falls back to LEAD_NOTIFICATION_EMAIL.
# Failures ALSO go to Telegram, which is what catches a backup that stopped running
# altogether (that produces no failure email at all).
BACKUP_NOTIFICATION_EMAIL=

# -----------------------------------------------------------------------------
# FILAMENT ADMIN
# -----------------------------------------------------------------------------
# Panel is aliased away from /admin to reduce automated scanning (§7.4).
FILAMENT_PATH=theshark-hq
FILAMENT_BRAND_NAME="The Shark Web HQ"

# =============================================================================
# LOCAL DEVELOPMENT OVERRIDES
# =============================================================================
# For local work, replace the DB block above with:
#
#   DB_CONNECTION=sqlite
#
# and comment out DB_HOST / DB_PORT / DB_DATABASE / DB_USERNAME / DB_PASSWORD.
# The file database/database.sqlite is created automatically.
#
# Also switch email to the log driver so nothing is actually sent:
#
#   MAIL_MAILER=log
#   TELEGRAM_ALERTS_ENABLED=false
#   INDEXNOW_ENABLED=false
#   GOOGLE_INDEXING_ENABLED=false
# =============================================================================

# A daily log file with rotation: a single laravel.log on shared hosting grows without
# bound (93MB was measured locally) until it eats the cPanel disk quota.
LOG_DAILY_DAYS=14

# =============================================================================
# Trusted proxies (F2 hardening)
# =============================================================================
# Controls which machines may set X-Forwarded-For for $request->ip(). Leave EMPTY
# when the web server terminates client connections directly (no reverse proxy).
# Set to "*" behind a proxy that always OVERWRITES X-Forwarded-For (Cloudflare,
# LiteSpeed edge), or to a comma-separated list of proxy addresses/CIDRs.
# Too permissive = clients can spoof their IP and rotate rate-limit buckets.
# Too strict = every visitor collapses onto the proxy's single address and the
# visitor analytics silently starve. Confirm the deployment before setting it.
# Also raises the global API ceiling if the default 120/min is too tight:
# SHARKWEB_API_RATE_LIMIT=120
# TRUSTED_PROXIES=
# =============================================================================
